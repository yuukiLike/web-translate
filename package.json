{
	"name": "bilingual-web-translator",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"build:chrome": "npm run build:runtime && npm run build:options && npm run build:popup",
		"build:options": "node scripts/build-options.mjs",
		"build:popup": "node scripts/build-popup.mjs",
		"build:runtime": "node scripts/build-extension-runtime.mjs",
		"check": "npm run check:chrome",
		"check:chrome": "npm run check:runtime && npm run check:options && npm run check:popup && npm run check:source && npm test",
		"check:options": "node scripts/build-options.mjs --check",
		"check:popup": "node scripts/build-popup.mjs --check",
		"check:runtime": "node scripts/build-extension-runtime.mjs --check",
		"check:source": "node scripts/check-javascript.mjs",
		"test": "node --test --test-concurrency=4 test/*/*.test.mjs",
		"test:catalog": "node --test test/contract/provider-config.test.mjs",
		"test:unit": "node --test test/unit/*.test.mjs",
		"validate:provider-catalog": "node scripts/validate-provider-config.mjs"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.27",
		"@ai-sdk/deepseek": "3.0.19",
		"@ai-sdk/google": "4.0.31",
		"@ai-sdk/openai": "4.0.27",
		"ai": "7.0.49",
		"vue": "3.5.40"
	},
	"devDependencies": {
		"@vue/compiler-sfc": "3.5.40",
		"ajv": "8.20.0",
		"esbuild": "0.28.1",
		"happy-dom": "20.11.1"
	}
}
