{
	"compilerOptions": {
		"allowJs": false,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2023",
		"types": ["node", "react"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
