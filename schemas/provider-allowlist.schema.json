{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://bilingual-web-translator.invalid/schemas/provider-allowlist.schema.json",
	"type": "object",
	"additionalProperties": false,
	"required": ["$schema", "schemaVersion", "defaultProviderId", "providers"],
	"properties": {
		"$schema": { "const": "../schemas/provider-allowlist.schema.json" },
		"schemaVersion": { "const": 1 },
		"defaultProviderId": { "$ref": "#/$defs/providerId" },
		"providers": {
			"type": "array",
			"minItems": 4,
			"maxItems": 4,
			"items": { "$ref": "#/$defs/provider" }
		}
	},
	"$defs": {
		"providerId": {
			"enum": ["deepseek", "openai", "google", "anthropic"],
			"type": "string"
		},
		"provider": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "sdkPackage", "apiBaseURL", "defaultModelId"],
			"properties": {
				"id": { "$ref": "#/$defs/providerId" },
				"sdkPackage": {
					"enum": [
						"@ai-sdk/deepseek",
						"@ai-sdk/openai",
						"@ai-sdk/google",
						"@ai-sdk/anthropic"
					],
					"type": "string"
				},
				"apiBaseURL": {
					"pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:/[A-Za-z0-9._~-]+)*$",
					"type": "string"
				},
				"defaultModelId": {
					"pattern": "^[a-z0-9][a-z0-9._-]*$",
					"type": "string"
				}
			}
		}
	}
}
